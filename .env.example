# ==============================================================================
# Plant Care AI Monorepo — Global Environment Variables
# ==============================================================================
# Copy this file to .env in backend-python or frontend as needed.

# ─── Python AI Engine & Flask Service (backend-python/) ───────────────────────
MODEL_PATH=data/models/plant_model.h5
LABELS_PATH=data/models/labels.json
IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.5
TOP_K_PREDICTIONS=5

# Upload Settings
MAX_UPLOAD_MB=10
UPLOAD_FOLDER=data/uploads

# Database
DB_PATH=plant_care.db

# Flask Server
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=false
SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/plant_care.log

# ─── Java Spring Boot Backend (backend-java/) ─────────────────────────────────
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/plantcare_db
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=root
# SERVER_PORT=8080

# ─── Frontend Configuration (frontend/) ───────────────────────────────────────
# VITE_API_BASE_URL=http://localhost:8080

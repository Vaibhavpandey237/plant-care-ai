# Environment Variables for Plant Care AI Detection System
# Copy this file to .env and adjust values as needed.

# ─── Model ────────────────────────────────────────────────────────────────────
MODEL_PATH=data/models/plant_model.h5
LABELS_PATH=data/models/labels.json
IMAGE_SIZE=224
CONFIDENCE_THRESHOLD=0.5
TOP_K_PREDICTIONS=5

# ─── Upload ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10
UPLOAD_FOLDER=data/uploads

# ─── Database ─────────────────────────────────────────────────────────────────
DB_PATH=plant_care.db

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
DEBUG=false
SECRET_KEY=change-me-in-production

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/plant_care.log
